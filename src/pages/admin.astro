---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Admin Dashboard - Nyrazi BD</title>
  </head>

  <body class="bg-slate-100 text-gray-900 font-sans antialiased min-h-screen">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-40">
      <div class="max-w-6xl mx-auto p-4 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-blue-700">Nyrazi BD</h1>
          <p class="text-xs text-gray-500 font-medium">Store Management Portal</p>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" class="text-sm font-medium text-gray-600 hover:text-blue-700">← Back to Store</a>
          <button id="admin-logout-btn" class="text-sm text-red-600 hover:underline font-semibold">Logout</button>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-4 mt-6">
      <!-- LOGIN SECTION -->
      <section id="admin-login-section" class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-sm border border-gray-200 mt-12">
        <h2 class="text-xl font-bold text-center mb-6 text-gray-800">Admin Login</h2>
        <form id="admin-login-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" id="admin-email" required class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="admin@nyrazi.com" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input type="password" id="admin-password" required class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="••••••••" />
          </div>
          <p id="login-error" class="text-red-500 text-sm font-medium text-center"></p>
          <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition-colors">
            Access Dashboard
          </button>
        </form>
      </section>

      <!-- DASHBOARD SECTION -->
      <section id="admin-dashboard-section" class="space-y-6 hidden">
        <!-- Tab Controls -->
        <div class="flex border-b border-gray-200 bg-white px-4 rounded-t-xl shadow-sm">
          <button id="tab-orders-btn" class="py-3 px-6 text-sm font-bold border-b-2 border-blue-600 text-blue-600 transition-colors">
            📦 Orders (<span id="total-orders-count">0</span>)
          </button>
          <button id="tab-products-btn" class="py-3 px-6 text-sm font-bold border-b-2 border-transparent text-gray-500 hover:text-gray-800 transition-colors">
            🏷️ Products (<span id="total-products-count">0</span>)
          </button>
        </div>

        <!-- VIEW 1: ORDERS -->
        <div id="view-orders" class="space-y-4">
          <div class="flex flex-wrap justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-gray-200 gap-4">
            <h2 class="text-md font-bold text-gray-800">Order Management</h2>
            <div class="flex items-center gap-2">
              <label for="status-filter" class="text-xs font-semibold text-gray-600">Filter Status:</label>
              <select id="status-filter" class="border border-gray-300 rounded-lg text-sm p-2 bg-gray-50 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <option value="ALL">All Orders</option>
                <option value="Pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
              </select>
            </div>
          </div>

          <div id="admin-orders-list" class="space-y-4">
            <p class="text-gray-500 text-center py-10 animate-pulse">Loadiing orders...</p>
          </div>
        </div>

        <!-- VIEW 2: PRODUCTS -->
        <div id="view-products" class="space-y-6 hidden">
          <!-- Add / Edit Product Form -->
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
            <h3 id="form-title" class="text-md font-bold text-gray-800 mb-4 border-b pb-2">Add / Edit Product</h3>
            <form id="product-form" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Product Name *</label>
                <input type="text" id="prod-name" required class="w-full border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="e.g. Wireless Mouse" />
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Price (BDT ৳) *</label>
                <input type="number" id="prod-price" required class="w-full border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="1200" />
              </div>

              <div class="md:col-span-2">
                <label class="block text-xs font-semibold text-gray-700 mb-1">Image URL</label>
                <input type="url" id="prod-image" class="w-full border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="https://images.unsplash.com/photo-..." />
              </div>

              <div class="flex items-center gap-2">
                <input type="checkbox" id="prod-stock" checked class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                <label for="prod-stock" class="text-sm font-medium text-gray-700">In Stock</label>
              </div>

              <div class="flex gap-2 justify-end md:col-span-2">
                <button type="button" id="cancel-edit-btn" class="hidden bg-gray-200 text-gray-700 text-sm font-bold px-4 py-2 rounded-lg hover:bg-gray-300">
                  Cancel
                </button>
                <button type="submit" id="form-submit-btn" class="bg-blue-600 text-white text-sm font-bold px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                  Add Product
                </button>
              </div>
            </form>
          </div>

          <!-- Existing Products Grid -->
          <div id="admin-products-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <p class="text-gray-500 text-center py-10 col-span-full animate-pulse">Loading products...</p>
          </div>
        </div>
      </section>
    </main>

    <script>
      import { initAdmin } from "../scripts/admin.js";
      initAdmin();
    </script>
  </body>
</html>