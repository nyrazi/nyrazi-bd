---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Checkout - Nyrazi BD</title>
  </head>

  <body class="bg-slate-100 text-gray-900 font-sans antialiased">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-40">
      <div class="max-w-6xl mx-auto p-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-blue-700">Nyrazi BD</a>
        <a href="/" class="text-sm font-medium text-gray-600 hover:text-blue-700">← Back to Store</a>
      </div>
    </header>

    <!-- Main Checkout Container -->
    <main class="max-w-4xl mx-auto p-4 mt-8">
      <h2 class="text-2xl font-bold mb-6">Checkout</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Customer Details Form -->
        <div class="md:col-span-2 bg-white p-6 rounded-xl shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-4 border-b pb-2">Delivery Information</h3>
          
          <form id="checkout-form" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
              <input type="text" id="cust-name" required class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="e.g. Rahim Ahmed" />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
              <input type="tel" id="cust-phone" required class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="017XXXXXXXX" />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Delivery Address *</label>
              <textarea id="cust-address" required rows="2" class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="House/Road no, Area details"></textarea>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">District / City *</label>
              <input type="text" id="cust-district" required class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="e.g. Dhaka, Sirajganj" />
            </div>

            <div class="pt-4 border-t">
              <h4 class="text-md font-semibold mb-2">Payment Method</h4>
              <label class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-slate-50">
                <input type="radio" name="payment" value="COD" checked class="text-blue-600 focus:ring-blue-500" />
                <div>
                  <p class="font-medium text-sm">Cash on Delivery (COD)</p>
                  <p class="text-xs text-gray-500">Pay cash when receiving product</p>
                </div>
              </label>
            </div>

            <p id="form-error" class="text-red-500 text-sm font-medium"></p>

            <button type="submit" id="submit-order-btn" class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition-colors mt-4">
              Confirm Order
            </button>
          </form>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 h-fit">
          <h3 class="text-lg font-semibold mb-4 border-b pb-2">Order Summary</h3>
          
          <div id="order-summary-items" class="space-y-3 mb-4">
            <!-- Dynamic items load here -->
          </div>

          <div class="border-t pt-3 flex justify-between items-center font-bold text-lg">
            <span>Total Payable:</span>
            <span id="checkout-total" class="text-blue-600">৳0</span>
          </div>
        </div>
      </div>
    </main>

    <script>
      import { initCheckout } from "../scripts/checkout.js";
      initCheckout();
    </script>
  </body>
</html>