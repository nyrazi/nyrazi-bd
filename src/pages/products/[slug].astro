---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Container from "@/components/ui/Container.astro";
import { products } from "@/data/products";

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Header />

<Container>

  <section class="grid gap-16 py-20 lg:grid-cols-2">

    <!-- Image -->
    <div class="flex aspect-square items-center justify-center rounded-3xl bg-slate-100">
      <span class="text-slate-400">Product Image</span>
    </div>

    <!-- Info -->
    <div>

      <p class="text-blue-600 font-semibold">
        {product.category}
      </p>

      <h1 class="mt-3 text-5xl font-bold">
        {product.name}
      </h1>

      <div class="mt-4 flex items-center gap-2">
        <span class="text-yellow-500">
          ★★★★★
        </span>

        <span class="text-slate-500">
          {product.rating} ({product.reviewCount} reviews)
        </span>
      </div>

      <div class="mt-8 flex items-center gap-4">

        <span class="text-4xl font-bold text-blue-600">
          ${product.price}
        </span>

        {
          product.compareAtPrice && (
            <span class="text-xl text-slate-400 line-through">
              ${product.compareAtPrice}
            </span>
          )
        }

      </div>

      <p class="mt-8 text-slate-600 leading-8">
        Premium quality product built for performance and reliability.
        We'll replace this with a real description later.
      </p>

      <div class="mt-10 flex gap-4">

        <button class="rounded-xl bg-blue-600 px-8 py-4 font-semibold text-white hover:bg-blue-700">
          Add to Cart
        </button>

        <button class="rounded-xl border border-slate-300 px-8 py-4 font-semibold hover:bg-slate-100">
          Add to Wishlist
        </button>

      </div>

    </div>

  </section>

</Container>

<Footer />