---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nyrazi BD - E-Commerce</title>
  </head>
  
  <body class="bg-slate-100 text-gray-900 font-sans antialiased">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-40">
      <div class="max-w-6xl mx-auto p-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-blue-700">Nyrazi BD</h1>
        
        <button id="open-cart-btn" class="relative bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium px-4 py-2 rounded-lg transition-colors flex items-center gap-2">
          <span>🛒 Cart</span>
          <span id="cart-count-badge" class="bg-blue-600 text-white text-xs font-bold px-2 py-0.5 rounded-full">0</span>
        </button>
      </div>
    </header>

    <!-- Main Storefront -->
    <main class="max-w-6xl mx-auto p-4 mt-8">
      <h2 class="text-xl font-semibold mb-6">Latest Products</h2>
      
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
         <p id="loading-text" class="text-gray-500 animate-pulse col-span-full text-center py-10">
           Loading live products...
         </p>
      </div>
    </main>

    <!-- Cart Drawer -->
    <div id="cart-drawer" class="fixed inset-0 z-50 invisible transition-all">
      <div id="cart-overlay" class="absolute inset-0 bg-black/40 opacity-0 transition-opacity"></div>
      
      <div class="absolute right-0 top-0 bottom-0 w-full max-w-md bg-white shadow-xl flex flex-col translate-x-full transition-transform duration-300">
        <div class="p-4 border-b flex justify-between items-center">
          <h3 class="text-lg font-bold">Your Shopping Cart</h3>
          <button id="close-cart-btn" class="text-gray-500 hover:text-black text-xl font-bold p-1">&times;</button>
        </div>

        <div id="cart-items-container" class="flex-1 overflow-y-auto p-4 space-y-4"></div>

        <div class="p-4 border-t bg-gray-50 space-y-3">
          <div class="flex justify-between font-bold text-lg">
            <span>Total:</span>
            <span id="cart-total-price">৳0</span>
          </div>
          <a href="/checkout" class="block text-center w-full bg-blue-600 text-white font-medium py-3 rounded-lg hover:bg-blue-700 transition-colors">
            Proceed to Checkout
          </a>
        </div>
      </div>
    </div>

    <!-- Clean Script Import -->
    <script>
      import { initStore } from "../scripts/cart.js";
      initStore();
    </script>
  </body>
</html>