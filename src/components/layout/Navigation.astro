---
import { navigation } from "../data/navigation";
---

<nav class="hidden items-center gap-8 md:flex">
  {
    navigation.map((item) => (
      <a
        href={item.href}
        class="transition hover:text-blue-600"
      >
        {item.name}
      </a>
    ))
  }

  <a
    href="/contact"
    class="rounded-lg bg-blue-600 px-5 py-2 text-white transition hover:bg-blue-700"
  >
    Contact
  </a>
</nav>