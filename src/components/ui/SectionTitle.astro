---
interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-12">

    <h2
        class="text-4xl font-bold tracking-tight text-slate-900"
    >
        {title}
    </h2>

    {
        subtitle && (
            <p class="mt-3 text-slate-500">
                {subtitle}
            </p>
        )
    }

</div>