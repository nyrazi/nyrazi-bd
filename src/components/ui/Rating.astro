---
interface Props {
    rating: number;
    reviews: number;
}

const { rating, reviews } = Astro.props;
---

<div class="flex items-center gap-2 text-sm">

    <span class="text-yellow-500">
        ★★★★★
    </span>

    <span class="text-slate-500">
        {rating} ({reviews})
    </span>

</div>