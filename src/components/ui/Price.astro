---
interface Props {
    price: number;
    compareAtPrice?: number;
}

const { price, compareAtPrice } = Astro.props;
---

<div class="flex items-center gap-3">

    <span class="text-2xl font-bold text-blue-600">
        ${price}
    </span>

    {
        compareAtPrice && (
            <span class="text-slate-400 line-through">
                ${compareAtPrice}
            </span>
        )
    }

</div>