---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
---

<section class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-white to-slate-100">
  <!-- Background Blur -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute left-10 top-20 h-72 w-72 rounded-full bg-blue-200/40 blur-3xl"></div>
    <div class="absolute right-10 bottom-0 h-96 w-96 rounded-full bg-sky-200/40 blur-3xl"></div>
  </div>

  <Container>
    <div class="grid min-h-[700px] items-center gap-16 py-20 lg:grid-cols-2">

      <!-- Left -->
      <div>

        <span class="inline-flex rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700">
          🚀 New Collection 2026
        </span>

        <h1 class="mt-6 text-5xl font-extrabold leading-tight text-slate-900 lg:text-7xl">
          Technology
          <br />
          Built For
          <br />
          Everyday Life
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-8 text-slate-600">
          Discover premium laptops, smartphones, accessories and gaming gear
          from trusted brands with competitive prices and fast nationwide
          delivery.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">

          <Button href="/products">
            Shop Now
          </Button>

          <Button
            href="/categories"
            variant="secondary"
          >
            Browse Categories
          </Button>

        </div>

        <!-- Features -->
        <div class="mt-16 grid gap-6 sm:grid-cols-3">

          <div class="flex items-center gap-3">
            <div class="rounded-xl bg-blue-100 p-3">
              🚚
            </div>

            <div>
              <h3 class="font-semibold">
                Free Shipping
              </h3>

              <p class="text-sm text-slate-500">
                Orders over $99
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="rounded-xl bg-blue-100 p-3">
              🔒
            </div>

            <div>
              <h3 class="font-semibold">
                Secure Payment
              </h3>

              <p class="text-sm text-slate-500">
                SSL Protected
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="rounded-xl bg-blue-100 p-3">
              ⭐
            </div>

            <div>
              <h3 class="font-semibold">
                Warranty
              </h3>

              <p class="text-sm text-slate-500">
                Up to 2 Years
              </p>
            </div>
          </div>

        </div>

      </div>

      <!-- Right -->
      <div class="relative flex justify-center">

        <!-- Background Circle -->
        <div class="absolute h-[460px] w-[460px] rounded-full bg-blue-100 blur-3xl"></div>

        <!-- Hero Card -->
        <div class="relative flex h-[540px] w-[430px] items-center justify-center rounded-[32px] border border-slate-200 bg-white shadow-2xl">

          <!-- Floating Card -->
          <div class="absolute -left-10 top-12 rounded-2xl bg-white p-4 shadow-xl">

            <p class="text-xs text-slate-500">
              Customer Rating
            </p>

            <h3 class="mt-1 text-xl font-bold">
              ⭐ 4.9/5
            </h3>

          </div>

          <!-- Floating Card -->
          <div class="absolute -right-8 bottom-16 rounded-2xl bg-white p-4 shadow-xl">

            <p class="text-xs text-slate-500">
              Fast Delivery
            </p>

            <h3 class="mt-1 font-bold">
              🚚 2-3 Days
            </h3>

          </div>

          <!-- Replace this later -->
          <div class="text-center">

            <div class="mx-auto flex h-72 w-72 items-center justify-center rounded-full bg-slate-100">

              <span class="text-8xl">
                💻
              </span>

            </div>

            <p class="mt-6 text-slate-400">
              Hero Product Image
            </p>

          </div>

        </div>

      </div>

    </div>
  </Container>
</section>