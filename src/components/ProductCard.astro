---
import type { Product } from "../types/product";

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<div
    class="group rounded-2xl border border-slate-200 bg-white p-5 transition duration-300 hover:-translate-y-1 hover:shadow-xl"
>

    <div
        class="flex h-56 items-center justify-center rounded-xl bg-slate-100"
    >
        <img
            src={product.image}
            alt={product.name}
            class="max-h-44 object-contain transition group-hover:scale-105"
        />
    </div>

    <div class="mt-5">

        <p class="text-sm text-slate-500">
            {product.category}
        </p>

        <h3 class="mt-1 text-lg font-semibold">
            {product.name}
        </h3>

        <p class="mt-3 text-2xl font-bold text-blue-600">
            ${product.price}
        </p>

        <button
            class="mt-5 w-full rounded-xl bg-slate-900 py-3 font-medium text-white transition hover:bg-blue-600"
        >
            Add to Cart
        </button>

    </div>

</div>